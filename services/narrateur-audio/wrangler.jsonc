{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "novyland-narrateur-audio",
	"main": "worker.mjs",
	"compatibility_date": "2026-10-24",
	"r2_buckets": [
		{
			"binding": "AUDIO",
			"bucket_name": "novyland-narrateur-audio"
		},
		{
			"bucket_name": "novyland-narrateur-audio",
			"binding": "novyland_narrateur_audio"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "COORDINATOR",
				"class_name": "AudioCoordinator"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"AudioCoordinator"
			]
		}
	],
	"vars": {
		"ALLOWED_ORIGINS": "https://novyland.ca,https://www.novyland.ca,https://novyland-cmd.github.io,http://127.0.0.1:8765,http://localhost:8765,http://127.0.0.1:5500,http://localhost:5500",
		"MAX_DAILY_CHARACTERS": "30000",
		"AUDIO_REVISION": "1"
	}
}
