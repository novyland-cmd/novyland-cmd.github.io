{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "novyland-tournoi",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-24",
  "durable_objects": { "bindings": [{ "name": "TOURNAMENTS", "class_name": "TournamentStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TournamentStore"] }],
  "vars": {
    "ALLOWED_ORIGINS": "https://novyland.ca,https://www.novyland.ca,https://novyland-cmd.github.io,http://127.0.0.1:8765,http://localhost:8765"
  }
}
